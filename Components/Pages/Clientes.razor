@page "/clientes"
@inject SesionService Sesion
@inject NavigationManager Nav
@rendermode InteractiveServer
@inject FinancieraConsumo.Web.Data.ApplicationDbContext Db
@using FinancieraConsumo.Web.Models.Entities
@using Microsoft.EntityFrameworkCore

<PageTitle>Clientes</PageTitle>

<h3 class="mb-4">Gestión de Clientes</h3>

<button class="btn btn-success mb-3" @onclick="NuevoCliente">
    Nuevo Cliente
</button>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert @tipoAlerta alert-dismissible fade show">
        @mensaje
        <button class="btn-close" @onclick="CerrarAlerta"></button>
    </div>
}

@if (idAEliminar != null)
{
    <div class="alert alert-warning">
        <strong>¿Seguro que deseas eliminar este cliente?</strong>

        <div class="mt-2">
            <button class="btn btn-danger me-2" @onclick="EliminarConfirmado">
                Sí, eliminar
            </button>

            <button class="btn btn-secondary" @onclick="CancelarEliminar">
                Cancelar
            </button>
        </div>
    </div>
}

@if (mostrarFormulario)
{
    <div class="card shadow mb-4">
        <div class="card-header bg-success text-white">
            @(editando ? "Editar Cliente" : "Registrar Cliente")
        </div>

        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-4">
                    <label>Cédula</label>
                    <input class="form-control" @bind="clienteActual.DocumentoIdentidad" />
                </div>

                <div class="col-md-4">
                    <label>Nombres</label>
                    <input class="form-control" @bind="clienteActual.Nombres" />
                </div>

                <div class="col-md-4">
                    <label>Apellidos</label>
                    <input class="form-control" @bind="clienteActual.Apellidos" />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label>Teléfono</label>
                    <input class="form-control" @bind="clienteActual.TelefonoCelular" />
                </div>

                <div class="col-md-4">
                    <label>Correo</label>
                    <input class="form-control" @bind="clienteActual.CorreoElectronico" />
                </div>

                <div class="col-md-4">
                    <label>Ingreso mensual</label>
                    <input type="number" class="form-control" @bind="clienteActual.IngresoMensual" />
                </div>
            </div>

            <div class="mb-3">
                <label>Dirección</label>
                <textarea class="form-control" @bind="clienteActual.DireccionDomicilio"></textarea>
            </div>

            <button class="btn btn-primary" @onclick="GuardarCliente">
                @(editando ? "Actualizar" : "Guardar")
            </button>

            <button class="btn btn-secondary ms-2" @onclick="Cancelar">
                Cancelar
            </button>
        </div>
    </div>
}

<div class="card shadow">
    <div class="card-header bg-primary text-white">
        Lista de Clientes
    </div>

    <div class="card-body">

        <div class="mb-3">
            <input class="form-control"
                   placeholder="Buscar por cédula, nombre, apellido o teléfono..."
                   @oninput="Buscar" />
        </div>
        <select class="form-select w-auto mb-3"
                @onchange="CambiarCantidad">
            <option value="5">5</option>
            <option value="10">10</option>
            <option value="20">20</option>
        </select>

        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Cédula</th>
                    <th>Nombres</th>
                    <th>Apellidos</th>
                    <th>Teléfono</th>
                    <th>Ingreso</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var cliente in clientes)
                {
                    <tr>
                        <td>@cliente.DocumentoIdentidad</td>
                        <td>@cliente.Nombres</td>
                        <td>@cliente.Apellidos</td>
                        <td>@cliente.TelefonoCelular</td>
                        <td>@cliente.IngresoMensual.ToString("N2")</td>

                        <td>
                            <button class="btn btn-warning btn-sm"
                                    @onclick="() => Editar(cliente)">
                                Editar
                            </button>

                            <button class="btn btn-danger btn-sm ms-2"
                                    @onclick="() => ConfirmarEliminar(cliente.IdCliente)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="mt-2">
            Mostrando @((paginaActual - 1) * registrosPorPagina + 1)
            -
            @(Math.Min(paginaActual * registrosPorPagina, totalRegistros))
            de @totalRegistros registros
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <button class="btn btn-outline-primary"
                    @onclick="PaginaAnterior"
                    disabled="@(paginaActual == 1)">
                Anterior
            </button>

            <span>Página @paginaActual de @totalPaginas</span>

            <button class="btn btn-outline-primary"
                    @onclick="PaginaSiguiente"
                    disabled="@(paginaActual == totalPaginas || totalPaginas == 0)">
                Siguiente
            </button>
        </div>
    </div>
</div>

@code {
    List<Cliente> clientes = new();
    Cliente clienteActual = new();

    bool mostrarFormulario = false;
    bool editando = false;

    string mensaje = "";
    string tipoAlerta = "alert-success";
    string textoBusqueda = "";

    int? idAEliminar = null;

    int paginaActual = 1;
    int registrosPorPagina = 5;
    int totalRegistros = 0;
    int totalPaginas = 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }

    async Task CargarClientes()
    {
        var query = Db.Clientes
            .Where(c =>
                c.Estado &&
                (
                    string.IsNullOrEmpty(textoBusqueda) ||
                    c.DocumentoIdentidad.Contains(textoBusqueda) ||
                    c.Nombres.Contains(textoBusqueda) ||
                    c.Apellidos.Contains(textoBusqueda) ||
                    c.TelefonoCelular.Contains(textoBusqueda)
                )
            );

        totalRegistros = await query.CountAsync();

        totalPaginas = (int)Math.Ceiling(totalRegistros / (double)registrosPorPagina);

        if (totalPaginas == 0)
        {
            paginaActual = 1;
        }
        else if (paginaActual > totalPaginas)
        {
            paginaActual = totalPaginas;
        }

        clientes = await query
            .OrderBy(c => c.IdCliente)
            .Skip((paginaActual - 1) * registrosPorPagina)
            .Take(registrosPorPagina)
            .ToListAsync();
    }

    async Task Buscar(ChangeEventArgs e)
    {
        textoBusqueda = e.Value?.ToString() ?? "";
        paginaActual = 1;
        await CargarClientes();
    }

    async Task PaginaAnterior()
    {
        if (paginaActual > 1)
        {
            paginaActual--;
            await CargarClientes();
        }
    }
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && !Sesion.EstaLogueado)
        {
            Nav.NavigateTo("/login");
        }
    }

    async Task PaginaSiguiente()
    {
        if (paginaActual < totalPaginas)
        {
            paginaActual++;
            await CargarClientes();
        }
    }

    void CerrarAlerta()
    {
        mensaje = "";
    }

    void NuevoCliente()
    {
        clienteActual = new Cliente
        {
            FechaRegistro = DateTime.Now,
            Estado = true
        };

        mostrarFormulario = true;
        editando = false;
    }

    void Editar(Cliente cliente)
    {
        clienteActual = cliente;
        mostrarFormulario = true;
        editando = true;
    }

    async Task GuardarCliente()
    {
        if (string.IsNullOrWhiteSpace(clienteActual.DocumentoIdentidad) ||
            string.IsNullOrWhiteSpace(clienteActual.Nombres) ||
            string.IsNullOrWhiteSpace(clienteActual.Apellidos) ||
            string.IsNullOrWhiteSpace(clienteActual.TelefonoCelular) ||
            string.IsNullOrWhiteSpace(clienteActual.DireccionDomicilio) ||
            clienteActual.IngresoMensual <= 0)
        {
            mensaje = "Complete todos los campos obligatorios correctamente.";
            tipoAlerta = "alert-danger";
            return;
        }

        if (!editando)
        {
            Db.Clientes.Add(clienteActual);
            mensaje = "Cliente registrado correctamente.";
        }
        else
        {
            Db.Clientes.Update(clienteActual);
            mensaje = "Cliente actualizado correctamente.";
        }

        await Db.SaveChangesAsync();

        tipoAlerta = "alert-success";
        mostrarFormulario = false;
        editando = false;
        clienteActual = new Cliente();

        await CargarClientes();
    }
    async Task CambiarCantidad(ChangeEventArgs e)
    {
        registrosPorPagina = int.Parse(e.Value!.ToString()!);
        paginaActual = 1;
        await CargarClientes();
    }

    void ConfirmarEliminar(int id)
    {
        idAEliminar = id;
    }

    async Task EliminarConfirmado()
    {
        if (idAEliminar != null)
        {
            var cliente = await Db.Clientes.FindAsync(idAEliminar);

            if (cliente != null)
            {
                cliente.Estado = false;
                await Db.SaveChangesAsync();

                mensaje = "Cliente eliminado correctamente.";
                tipoAlerta = "alert-warning";

                await CargarClientes();
            }
        }

        idAEliminar = null;
    }

    void CancelarEliminar()
    {
        idAEliminar = null;
    }

    void Cancelar()
    {
        mostrarFormulario = false;
        editando = false;
        clienteActual = new Cliente();
    }
}