@page "/fiadores"
@rendermode InteractiveServer
@inject FinancieraConsumo.Web.Data.ApplicationDbContext Db
@using FinancieraConsumo.Web.Models.Entities
@using Microsoft.EntityFrameworkCore

<PageTitle>Fiadores</PageTitle>

<h3 class="mb-4 text-primary fw-bold">Gestión de Fiadores</h3>

<button class="btn btn-success mb-3" @onclick="NuevoFiador">
    Nuevo Fiador
</button>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert @tipoAlerta alert-dismissible fade show">
        @mensaje
        <button class="btn-close" @onclick="CerrarAlerta"></button>
    </div>
}

@if (idAEliminar != null)
{
    <div class="alert alert-warning">
        <strong>¿Seguro que deseas eliminar este fiador?</strong>

        <div class="mt-2">
            <button class="btn btn-danger me-2" @onclick="EliminarConfirmado">
                Sí, eliminar
            </button>

            <button class="btn btn-secondary" @onclick="CancelarEliminar">
                Cancelar
            </button>
        </div>
    </div>
}

@if (mostrarFormulario)
{
    <div class="card shadow mb-4">
        <div class="card-header bg-success text-white">
            @(editando ? "Editar Fiador" : "Registrar Fiador")
        </div>

        <div class="card-body">

            <div class="row mb-3">
                <div class="col-md-4">
                    <label>Cédula</label>
                    <input class="form-control" @bind="fiadorActual.DocumentoIdentidad" />
                </div>

                <div class="col-md-4">
                    <label>Nombres</label>
                    <input class="form-control" @bind="fiadorActual.Nombres" />
                </div>

                <div class="col-md-4">
                    <label>Apellidos</label>
                    <input class="form-control" @bind="fiadorActual.Apellidos" />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label>Teléfono</label>
                    <input class="form-control" @bind="fiadorActual.TelefonoCelular" />
                </div>

                <div class="col-md-4">
                    <label>Ingreso mensual</label>
                    <input type="number" class="form-control" @bind="fiadorActual.IngresoMensual" />
                </div>
            </div>

            <div class="mb-3">
                <label>Dirección</label>
                <textarea class="form-control" @bind="fiadorActual.DireccionDomicilio"></textarea>
            </div>

            <button class="btn btn-primary" @onclick="GuardarFiador">
                @(editando ? "Actualizar" : "Guardar")
            </button>

            <button class="btn btn-secondary ms-2" @onclick="Cancelar">
                Cancelar
            </button>

        </div>
    </div>
}

<div class="card shadow">
    <div class="card-header bg-primary text-white">
        Lista de Fiadores
    </div>

    <div class="card-body">

        <div class="mb-3">
            <input class="form-control"
                   placeholder="Buscar fiador..."
                   @oninput="Buscar" />
        </div>

        <select class="form-select w-auto mb-3" @onchange="CambiarCantidad">
            <option value="5">5 registros</option>
            <option value="10">10 registros</option>
            <option value="20">20 registros</option>
        </select>

        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Cédula</th>
                    <th>Nombres</th>
                    <th>Apellidos</th>
                    <th>Teléfono</th>
                    <th>Ingreso</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var fiador in fiadores)
                {
                    <tr>
                        <td>@fiador.DocumentoIdentidad</td>
                        <td>@fiador.Nombres</td>
                        <td>@fiador.Apellidos</td>
                        <td>@fiador.TelefonoCelular</td>
                        <td>@fiador.IngresoMensual.ToString("N2")</td>

                        <td>
                            <button class="btn btn-warning btn-sm"
                                    @onclick="() => Editar(fiador)">
                                Editar
                            </button>

                            <button class="btn btn-danger btn-sm ms-2"
                                    @onclick="() => ConfirmarEliminar(fiador.IdFiador)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-2">
            Mostrando @((paginaActual - 1) * registrosPorPagina + 1)
            -
            @(Math.Min(paginaActual * registrosPorPagina, totalRegistros))
            de @totalRegistros registros
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <button class="btn btn-outline-primary"
                    @onclick="PaginaAnterior"
                    disabled="@(paginaActual == 1)">
                Anterior
            </button>

            <span>Página @paginaActual de @totalPaginas</span>

            <button class="btn btn-outline-primary"
                    @onclick="PaginaSiguiente"
                    disabled="@(paginaActual == totalPaginas || totalPaginas == 0)">
                Siguiente
            </button>
        </div>

    </div>
</div>

@code {

    List<Fiador> fiadores = new();
    Fiador fiadorActual = new();

    bool mostrarFormulario = false;
    bool editando = false;

    string mensaje = "";
    string tipoAlerta = "alert-success";
    string textoBusqueda = "";

    int? idAEliminar = null;

    int paginaActual = 1;
    int registrosPorPagina = 5;
    int totalRegistros = 0;
    int totalPaginas = 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarFiadores();
    }

    async Task CargarFiadores()
    {
        var query = Db.Fiadores
            .Where(f =>
                string.IsNullOrEmpty(textoBusqueda) ||
                f.DocumentoIdentidad.Contains(textoBusqueda) ||
                f.Nombres.Contains(textoBusqueda) ||
                f.Apellidos.Contains(textoBusqueda) ||
                f.TelefonoCelular.Contains(textoBusqueda)
            );

        totalRegistros = await query.CountAsync();
        totalPaginas = (int)Math.Ceiling(totalRegistros / (double)registrosPorPagina);

        fiadores = await query
            .OrderBy(f => f.IdFiador)
            .Skip((paginaActual - 1) * registrosPorPagina)
            .Take(registrosPorPagina)
            .ToListAsync();
    }

    async Task Buscar(ChangeEventArgs e)
    {
        textoBusqueda = e.Value?.ToString() ?? "";
        paginaActual = 1;
        await CargarFiadores();
    }

    async Task CambiarCantidad(ChangeEventArgs e)
    {
        registrosPorPagina = int.Parse(e.Value!.ToString()!);
        paginaActual = 1;
        await CargarFiadores();
    }

    async Task PaginaAnterior()
    {
        if (paginaActual > 1)
        {
            paginaActual--;
            await CargarFiadores();
        }
    }

    async Task PaginaSiguiente()
    {
        if (paginaActual < totalPaginas)
        {
            paginaActual++;
            await CargarFiadores();
        }
    }

    void NuevoFiador()
    {
        fiadorActual = new Fiador { FechaRegistro = DateTime.Now };
        mostrarFormulario = true;
        editando = false;
    }

    void Editar(Fiador f)
    {
        fiadorActual = f;
        mostrarFormulario = true;
        editando = true;
    }

    async Task GuardarFiador()
    {
        if (!editando)
            Db.Fiadores.Add(fiadorActual);
        else
            Db.Fiadores.Update(fiadorActual);

        await Db.SaveChangesAsync();

        mensaje = "Operación realizada correctamente.";
        tipoAlerta = "alert-success";

        mostrarFormulario = false;
        editando = false;

        await CargarFiadores();
    }

    void ConfirmarEliminar(int id)
    {
        idAEliminar = id;
    }

    async Task EliminarConfirmado()
    {
        var f = await Db.Fiadores.FindAsync(idAEliminar);
        if (f != null)
        {
            Db.Fiadores.Remove(f);
            await Db.SaveChangesAsync();
            await CargarFiadores();
        }

        idAEliminar = null;
    }

    void CancelarEliminar()
    {
        idAEliminar = null;
    }

    void Cancelar()
    {
        mostrarFormulario = false;
        editando = false;
    }

    void CerrarAlerta()
    {
        mensaje = "";
    }
}