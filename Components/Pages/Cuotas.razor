@page "/cuotas"
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject SesionService Sesion
@inject NavigationManager Nav
@inject FinancieraConsumo.Web.Data.ApplicationDbContext Db
@using FinancieraConsumo.Web.Models.Entities
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop

<h3 class="mb-4 text-primary fw-bold">Cuotas por Crédito</h3>

<div class="card shadow mb-4">
    <div class="card-body">
        <label>Seleccionar crédito</label>

        <select class="form-select" @bind="idCreditoSeleccionado" @bind:after="CargarCuotasCredito">
            <option value="0">-- Seleccione --</option>
            @foreach (var c in creditos)
            {
                <option value="@c.IdCredito">
                    Crédito #@c.IdCredito - Monto: @c.MontoOtorgado.ToString("N2")
                </option>
            }
        </select>
    </div>
</div>

@if (clienteSeleccionado != null && creditoSeleccionado != null)
{
    <div class="card shadow mb-3">
        <div class="card-header bg-info text-white">
            Información del Cliente
        </div>
        <div class="card-body">
            <p><strong>Cliente:</strong> @clienteSeleccionado.Nombres @clienteSeleccionado.Apellidos</p>
            <p><strong>Cédula:</strong> @clienteSeleccionado.DocumentoIdentidad</p>
            <p><strong>Teléfono:</strong> @clienteSeleccionado.TelefonoCelular</p>
            <p><strong>Ingreso mensual:</strong> @clienteSeleccionado.IngresoMensual.ToString("N2")</p>
            <p><strong>Crédito:</strong> #@creditoSeleccionado.IdCredito</p>
            <p><strong>Monto:</strong> @creditoSeleccionado.MontoOtorgado.ToString("N2")</p>
            <p><strong>Tasa anual:</strong> @creditoSeleccionado.TasaInteresAnual.ToString("N2")%</p>
        </div>
    </div>
}

@if (cuotas.Any())
{
    <div class="card shadow mb-4">
        <div class="card-header bg-primary text-white">
            Detalle de Cuotas
        </div>

        <div class="card-body">

            @if (cuotaAPagar != null)
            {
                <div class="alert alert-warning">
                    <strong>¿Confirmar pago de esta cuota?</strong>
                    <div class="mt-2">
                        <button class="btn btn-success me-2" @onclick="PagarConfirmado">Sí, pagar</button>
                        <button class="btn btn-secondary" @onclick="CancelarPago">Cancelar</button>
                    </div>
                </div>
            }

            <p><strong>Total pagado:</strong> @cuotas.Where(c => c.EstadoCuota == "Pagada").Sum(c => c.Capital + c.Interes + c.MoraAcumulada).ToString("N2")</p>
            <p><strong>Pendiente:</strong> @cuotas.Where(c => c.EstadoCuota != "Pagada").Sum(c => c.Capital + c.Interes + c.MoraAcumulada).ToString("N2")</p>

            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Capital</th>
                        <th>Interés</th>
                        <th>Mora</th>
                        <th>Total</th>
                        <th>Vencimiento</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cuota in cuotas)
                    {
                        <tr>
                            <td>@cuota.NumeroCuota</td>
                            <td>@cuota.Capital.ToString("N2")</td>
                            <td>@cuota.Interes.ToString("N2")</td>
                            <td>@cuota.MoraAcumulada.ToString("N2")</td>
                            <td>@((cuota.Capital + cuota.Interes + cuota.MoraAcumulada).ToString("N2"))</td>
                            <td>@cuota.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge @(cuota.EstadoCuota == "Pagada" ? "bg-success" : cuota.EstadoCuota == "Vencida" ? "bg-danger" : "bg-warning text-dark")">
                                    @cuota.EstadoCuota
                                </span>
                            </td>
                            <td>
                                @if (cuota.EstadoCuota == "Pagada")
                                {
                                    <a class="btn btn-secondary btn-sm me-1"
                                       href="@($"/imprimir-recibo/{cuota.IdCuota}")">
                                        PDF
                                    </a>

                                    <button class="btn btn-primary btn-sm"
                                            @onclick="() => ImprimirDirecto(cuota)">
                                        Imprimir
                                    </button>
                                }
                                else if (Sesion.UsuarioActual?.IdRol == 5 || Sesion.UsuarioActual?.IdRol == 4)
                                {
                                    <button class="btn btn-success btn-sm"
                                            @onclick="() => ConfirmarPago(cuota.IdCuota)">
                                        Pagar
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted">No permitido</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    int idCreditoSeleccionado = 0;
    int? cuotaAPagar = null;

    Credito? creditoSeleccionado = null;
    Cliente? clienteSeleccionado = null;

    List<Credito> creditos = new();
    List<Cuota> cuotas = new();

    protected override async Task OnInitializedAsync()
    {
        creditos = await Db.Creditos
            .OrderByDescending(c => c.IdCredito)
            .ToListAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!Sesion.EstaLogueado)
            {
                Nav.NavigateTo("/login");
                return;
            }

            var guardado = await JS.InvokeAsync<string>("localStorage.getItem", "creditoCuotasId");

            if (int.TryParse(guardado, out int idGuardado) && idGuardado > 0)
            {
                idCreditoSeleccionado = idGuardado;
                await CargarCuotasCredito();
                StateHasChanged();
            }
        }
    }

    async Task CargarCuotasCredito()
    {
        await JS.InvokeVoidAsync("localStorage.setItem", "creditoCuotasId", idCreditoSeleccionado.ToString());

        cuotas.Clear();
        clienteSeleccionado = null;
        creditoSeleccionado = null;

        if (idCreditoSeleccionado == 0)
            return;

        creditoSeleccionado = await Db.Creditos
            .FirstOrDefaultAsync(c => c.IdCredito == idCreditoSeleccionado);

        if (creditoSeleccionado != null)
        {
            var solicitud = await Db.SolicitudesCredito
                .FirstOrDefaultAsync(s => s.IdSolicitud == creditoSeleccionado.IdSolicitud);

            if (solicitud != null)
            {
                clienteSeleccionado = await Db.Clientes
                    .FirstOrDefaultAsync(c => c.IdCliente == solicitud.IdCliente);
            }
        }

        cuotas = await Db.Cuotas
            .Where(c => c.IdCredito == idCreditoSeleccionado)
            .OrderBy(c => c.NumeroCuota)
            .ToListAsync();
    }

    void ConfirmarPago(int id)
    {
        cuotaAPagar = id;
    }

    void CancelarPago()
    {
        cuotaAPagar = null;
    }

    async Task PagarConfirmado()
    {
        if (cuotaAPagar != null)
        {
            await PagarCuota(cuotaAPagar.Value);
        }

        cuotaAPagar = null;
    }

    async Task PagarCuota(int idCuota)
    {
        var cuota = await Db.Cuotas.FindAsync(idCuota);

        if (cuota == null || cuota.EstadoCuota == "Pagada")
            return;

        var existePendienteAnterior = await Db.Cuotas.AnyAsync(c =>
            c.IdCredito == cuota.IdCredito &&
            c.NumeroCuota < cuota.NumeroCuota &&
            c.EstadoCuota != "Pagada");

        if (existePendienteAnterior)
            return;

        var pago = new Pago
        {
            IdCredito = cuota.IdCredito,
            IdUsuarioCajero = Sesion.UsuarioActual?.IdUsuario ?? 1,
            MontoTotal = cuota.Capital + cuota.Interes + cuota.MoraAcumulada,
            FechaPago = DateTime.Now
        };

        Db.Pagos.Add(pago);
        await Db.SaveChangesAsync();

        var detalle = new PagoDetalle
        {
            IdPago = pago.IdPago,
            IdCuota = cuota.IdCuota,
            MontoAplicado = pago.MontoTotal
        };

        Db.PagosDetalle.Add(detalle);

        cuota.EstadoCuota = "Pagada";

        await Db.SaveChangesAsync();

        await CargarCuotasCredito();
    }

    async Task ImprimirDirecto(Cuota cuota)
    {
        var total = cuota.Capital + cuota.Interes + cuota.MoraAcumulada;

        var html = $@"
        <html>
        <body style='font-family:Arial; padding:25px;'>
            <h2 style='text-align:center;'>RECIBO DE PAGO</h2>
            <hr/>
            <p><b>Crédito:</b> #{cuota.IdCredito}</p>
            <p><b>Cuota:</b> #{cuota.NumeroCuota}</p>
            <p><b>Capital:</b> {cuota.Capital:N2}</p>
            <p><b>Interés:</b> {cuota.Interes:N2}</p>
            <p><b>Mora:</b> {cuota.MoraAcumulada:N2}</p>
            <h3>Total pagado: {total:N2}</h3>
            <p><b>Fecha:</b> {DateTime.Now:dd/MM/yyyy HH:mm}</p>
            <br/>
            <p>Firma cajero: ________________________</p>
        </body>
        </html>";

        await JS.InvokeVoidAsync("imprimirHtml", html);
    }
}