@page "/cuotas"
@inject SesionService Sesion
@inject NavigationManager Nav
@inject FinancieraConsumo.Web.Data.ApplicationDbContext Db
@using FinancieraConsumo.Web.Models.Entities
@using Microsoft.EntityFrameworkCore

<h3 class="mb-4 text-primary fw-bold">Cuotas por Crédito</h3>

<div class="card shadow mb-4">
    <div class="card-body">
        <label>Seleccionar crédito</label>
        <select class="form-select" @onchange="CargarCuotasCredito">
            <option value="0">-- Seleccione --</option>
            @foreach (var c in creditos)
            {
                <option value="@c.IdCredito">
                    Crédito #@c.IdCredito - Monto: @c.MontoOtorgado.ToString("N2")
                </option>
            }
        </select>
    </div>
</div>

@if (cuotas.Any())
{
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            Detalle de Cuotas
        </div>

        <div class="card-body">
            @if (cuotaAPagar != null)
            {
                <div class="alert alert-warning">
                    <strong>¿Confirmar pago de esta cuota?</strong>

                    <div class="mt-2">
                        <button type="button" class="btn btn-success me-2" @onclick="PagarConfirmado">
                            Sí, pagar
                        </button>

                        <button type="button" class="btn btn-secondary" @onclick="CancelarPago">
                            Cancelar
                        </button>
                    </div>
                </div>
            }
            <p><strong>Total pagado:</strong> @cuotas.Where(c => c.EstadoCuota == "Pagada").Sum(c => c.Capital + c.Interes)</p>

            <p><strong>Pendiente:</strong> @cuotas.Where(c => c.EstadoCuota != "Pagada").Sum(c => c.Capital + c.Interes + c.MoraAcumulada)</p>
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Capital</th>
                        <th>Interés</th>
                        <th>Mora</th>
                        <th>Total</th>
                        <th>Vencimiento</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>
                </thead>

                <tbody>
     @foreach (var cuota in cuotas)
{
    <tr>
        <td>@cuota.NumeroCuota</td>
        <td>@cuota.Capital.ToString("N2")</td>
        <td>@cuota.Interes.ToString("N2")</td>
        <td>@cuota.MoraAcumulada.ToString("N2")</td>
        <td>@((cuota.Capital + cuota.Interes + cuota.MoraAcumulada).ToString("N2"))</td>
        <td>@cuota.FechaVencimiento.ToString("dd/MM/yyyy")</td>

        <td>
            <span class="badge @(cuota.EstadoCuota == "Pagada" ? "bg-success" :
                               cuota.EstadoCuota == "Vencida" ? "bg-danger" :
                               "bg-warning text-dark")">
                @cuota.EstadoCuota
            </span>
        </td>

        <td>
            @if (cuota.EstadoCuota == "Pendiente" &&
                (Sesion.UsuarioActual?.IdRol == 5 || Sesion.UsuarioActual?.IdRol == 4))
            {
                <button class="btn btn-success btn-sm"
                        @onclick="() => ConfirmarPago(cuota.IdCuota)">
                    Pagar
                </button>
            }
            else
            {
                <span class="text-muted">No permitido</span>
            }
        </td>
    </tr>
}
                       
                    }
                </tbody>
              >

            </table>
          

            @if (cuotaAPagar != null)
            {
                <div class="alert alert-warning mt-3">
                    <strong>¿Confirmar pago de esta cuota?</strong>

                    <div class="mt-2">
                        <button class="btn btn-success me-2" @onclick="PagarConfirmado">
                            Sí, pagar
                        </button>

                        <button class="btn btn-secondary" @onclick="CancelarPago">
                            Cancelar
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    int? cuotaAPagar = null;

    List<Credito> creditos = new();
    List<Cuota> cuotas = new();


    protected override async Task OnInitializedAsync()
    {
        creditos = await Db.Creditos
            .OrderByDescending(c => c.IdCredito)
            .ToListAsync();
    }
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && !Sesion.EstaLogueado)
        {
            Nav.NavigateTo("/login");
        }
    }// bloqueado para redirigir si no hay sesión
    async Task CargarCuotasCredito(ChangeEventArgs e)
    {
        int idCredito = int.Parse(e.Value!.ToString()!);

        if (idCredito == 0)
        {
            cuotas.Clear();
            return;
        }

        cuotas = await Db.Cuotas
            .Where(c => c.IdCredito == idCredito)
            .OrderBy(c => c.NumeroCuota)
            .ToListAsync();

        
        foreach (var cuota in cuotas)
        {
            if (cuota.FechaVencimiento < DateTime.Today && cuota.EstadoCuota == "Pendiente")
            {
                cuota.EstadoCuota = "Vencida";
            }
        }
        bool cambios = false;

        foreach (var cuota in cuotas)
        {
            if (cuota.FechaVencimiento < DateTime.Today && cuota.EstadoCuota == "Pendiente")
            {
                cuota.EstadoCuota = "Vencida";
                cambios = true;
            }
        }

        if (cambios)
        {
            await Db.SaveChangesAsync();
        }
    }

    void ConfirmarPago(int id)
    {
        cuotaAPagar = id;
    }

    async Task PagarConfirmado()
    {
        if (cuotaAPagar != null)
        {
            await PagarCuota(cuotaAPagar.Value);
        }

        cuotaAPagar = null;
    }

    void CancelarPago()
    {
        cuotaAPagar = null;
    }

    async Task PagarCuota(int idCuota)
    {
        var cuota = await Db.Cuotas.FindAsync(idCuota);

        if (cuota == null || cuota.EstadoCuota != "Pendiente")
            return;

        var existePendienteAnterior = await Db.Cuotas
            .AnyAsync(c =>
                c.IdCredito == cuota.IdCredito &&
                c.NumeroCuota < cuota.NumeroCuota &&
                c.EstadoCuota == "Pendiente");

        if (existePendienteAnterior)
        {
            return;
        }

        var pago = new Pago
        {
            IdCredito = cuota.IdCredito,
            IdUsuarioCajero = 1,
            MontoTotal = cuota.Capital + cuota.Interes + cuota.MoraAcumulada
        };

        Db.Pagos.Add(pago);
        await Db.SaveChangesAsync();

        var detalle = new PagoDetalle
        {
            IdPago = pago.IdPago,
            IdCuota = cuota.IdCuota,
            MontoAplicado = pago.MontoTotal
        };

        Db.PagosDetalle.Add(detalle);

        cuota.EstadoCuota = "Pagada";

        await Db.SaveChangesAsync();

        cuotas = await Db.Cuotas
            .Where(c => c.IdCredito == cuota.IdCredito)
            .OrderBy(c => c.NumeroCuota)
            .ToListAsync();
    }
}