@page "/solicitudes"
@rendermode InteractiveServer
@inject FinancieraConsumo.Web.Data.ApplicationDbContext Db
@using FinancieraConsumo.Web.Models.Entities
@using Microsoft.EntityFrameworkCore

<h3 class="mb-4">Solicitudes de Crédito</h3>

<button class="btn btn-success mb-3" @onclick="Nueva">
    Nueva Solicitud
</button>

@if (mostrar)
{
    <div class="card p-3 mb-3">

        <label>Cliente</label>
        <select class="form-control" @bind="solicitud.IdCliente">
            @foreach (var c in clientes)
            {
                <option value="@c.IdCliente">@c.Nombres @c.Apellidos</option>
            }
        </select>

        <label>Fiador</label>
        <select class="form-control" @bind="solicitud.IdFiador">
            <option value="">-- Sin fiador --</option>
            @foreach (var f in fiadores)
            {
                <option value="@f.IdFiador">@f.Nombres @f.Apellidos</option>
            }
        </select>

        <label>Monto</label>
        <input type="number" class="form-control" @bind="solicitud.MontoSolicitado" />

        <label>Plazo (meses)</label>
        <input type="number" class="form-control" @bind="solicitud.PlazoMeses" />

        <button class="btn btn-primary mt-2" @onclick="Guardar">
            Guardar
        </button>
        <button class="btn btn-secondary mt-2 ms-2" @onclick="Cancelar">
            Cancelar
        </button>
    </div>
}

<table class="table table-hover">
    <thead class="table-dark">
        <tr>
            <th>Cliente</th>
            <th>Fiador</th>
            <th>Monto</th>
            <th>Plazo</th>
            <th>Estado</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var s in solicitudes)
        {
            <tr>
                <td>@ObtenerNombreCliente(s.IdCliente)</td>
                <td>@ObtenerNombreFiador(s.IdFiador)</td>
                <td>@s.MontoSolicitado</td>
                <td>@s.PlazoMeses</td>

                <td>
                    @s.EstadoSolicitud

                    @if (s.EstadoSolicitud == "Pendiente")
                    {
                        <button class="btn btn-success btn-sm ms-2"
                                @onclick="() => Aprobar(s.IdSolicitud)">
                            Aprobar
                        </button>

                        <button class="btn btn-danger btn-sm ms-2"
                                @onclick="() => Rechazar(s.IdSolicitud)">
                            Rechazar
                        </button>
                    }
                </td>
            </tr>
        } 
        </tbody>
        
</table>

@code {

    List<SolicitudCredito> solicitudes = new();
    List<Cliente> clientes = new();
    List<Fiador> fiadores = new();

    SolicitudCredito solicitud = new();

    bool mostrar = false;

    protected override async Task OnInitializedAsync()
    {
        clientes = await Db.Clientes.ToListAsync();
        fiadores = await Db.Fiadores.ToListAsync();

        await Cargar();
    }
    void Cancelar()
    {
        mostrar = false;
        solicitud = new SolicitudCredito();
    }

    async Task Cargar()
    {
        solicitudes = await Db.SolicitudesCredito.ToListAsync();
    }

    void Nueva()
    {
        solicitud = new SolicitudCredito
        {
            IdAnalista = 1
        };

        mostrar = true;
    }
    async Task Aprobar(int id)
    {
        var solicitud = await Db.SolicitudesCredito.FindAsync(id);

        if (solicitud != null)
        {
            solicitud.EstadoSolicitud = "Aprobada";

            var credito = new Credito
            {
                IdSolicitud = solicitud.IdSolicitud,
                MontoOtorgado = solicitud.MontoSolicitado,
                TasaInteresAnual = 12,
                PlazoMeses = solicitud.PlazoMeses,
                FechaInicio = DateTime.Today,
                FechaVencimiento = DateTime.Today.AddMonths(solicitud.PlazoMeses),
                EstadoCredito = "Vigente"
            };

            Db.Creditos.Add(credito);

         
            await Db.SaveChangesAsync();

            int numeroCuotas = solicitud.PlazoMeses;
            decimal monto = solicitud.MontoSolicitado;
            decimal interesAnual = 12;

            decimal interesMensual = interesAnual / 12 / 100;
            double interesMensualDouble = (double)interesMensual;

            decimal cuotaFija = monto * (decimal)(
                interesMensualDouble /
                (1 - Math.Pow(1 + interesMensualDouble, -numeroCuotas))
            );

            for (int i = 1; i <= numeroCuotas; i++)
            {
                decimal interes = monto * interesMensual;
                decimal capital = cuotaFija - interes;

                var cuota = new Cuota
                {
                    IdCredito = credito.IdCredito,
                    NumeroCuota = i,
                    Capital = capital,
                    Interes = interes,
                    FechaVencimiento = DateTime.Today.AddMonths(i)
                };

                Db.Cuotas.Add(cuota);

                monto -= capital;
            }

          
            await Db.SaveChangesAsync();

            await Cargar();
        }
    }

    async Task Rechazar(int id)
    {
        var solicitud = await Db.SolicitudesCredito.FindAsync(id);

        if (solicitud != null)
        {
            solicitud.EstadoSolicitud = "Rechazada";
            await Db.SaveChangesAsync();

            await Cargar();
        }
    }

    async Task Guardar()
    {
        if (solicitud.IdCliente <= 0 ||
            solicitud.MontoSolicitado <= 0 ||
            solicitud.PlazoMeses <= 0)
            return;

        solicitud.IdAnalista = 1;

        Db.SolicitudesCredito.Add(solicitud);
        await Db.SaveChangesAsync();

        mostrar = false;
        solicitud = new SolicitudCredito(); 

        await Cargar();
    }

    string ObtenerNombreCliente(int id)
    {
        var c = clientes.FirstOrDefault(x => x.IdCliente == id);
        return c != null ? c.Nombres + " " + c.Apellidos : "";
    }

    string ObtenerNombreFiador(int? id)
    {
        if (id == null) return "Sin fiador";

        var f = fiadores.FirstOrDefault(x => x.IdFiador == id);
        return f != null ? f.Nombres + " " + f.Apellidos : "";
    }
}