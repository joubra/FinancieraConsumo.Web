@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject SesionService Sesion

<div class="page">

    @if (!Nav.Uri.Contains("/login"))
    {
        <div class="sidebar">
            <NavMenu />
        </div>
    }

    <main>
        <div class="top-row px-4 d-flex justify-content-between">
            <h4>FinancieraConsumo.Web</h4>

            @if (Sesion.EstaLogueado)
            {
                <div>
                    <span class="me-3">
                        Usuario: <strong>@Sesion.UsuarioActual!.Username</strong>
                    </span>

                    <button class="btn btn-outline-danger btn-sm" @onclick="CerrarSesion">
                        Cerrar sesión
                    </button>
                </div>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>

</div>

@code {
    void CerrarSesion()
    {
        Sesion.CerrarSesion();
        Nav.NavigateTo("/login");
    }
}
